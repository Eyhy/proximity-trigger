---
import '../styles/global.css';

const title = 'Strike and Release | ROBIO 2026';
const description = 'Proximity-guided transient-contact control for clear, repeatable robotic percussion.';
const base = import.meta.env.BASE_URL;
const canonical = new URL(base, Astro.site);
const schema = {
  '@context': 'https://schema.org',
  '@type': 'ScholarlyArticle',
  headline: 'Strike and Release: Proximity-Guided Transient-Contact Control for Robotic Percussion',
  author: [{ '@type': 'Person', name: 'Hongyi Yang' }, { '@type': 'Person', name: 'Chenxi Xiao' }],
  affiliation: { '@type': 'CollegeOrUniversity', name: 'ShanghaiTech University' },
  datePublished: '2026',
  description,
  image: new URL(`${base}images/teaser.svg`, Astro.site).href
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="author" content="Hongyi Yang and Chenxi Xiao" />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(`${base}images/teaser.svg`, Astro.site)} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <title>{title}</title>
  </head>
  <body><slot /></body>
</html>
